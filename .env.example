# Gemini: taxonomy, annotation, RAGAS. Add GEMINI_API_KEY_2, _3, ... for key rotation.
GEMINI_API_KEY=

# Groq: chat agent and /api/visualize
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Neo4j (optional; falls back to an in-memory NetworkX graph)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

LOG_LEVEL=INFO
